/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
  X-Frame-Options: SAMEORIGIN

# Somente o widget pode ser incorporado por outros sites. Ele não usa
# geolocalização e permanece fora dos resultados de busca.
/widget*
  ! X-Frame-Options
  Content-Security-Policy: frame-ancestors *
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Robots-Tag: noindex

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# O navegador deve conferir o service worker em toda abertura; os demais
# recursos continuam usando o cache controlado pelo próprio aplicativo.
/sw.js
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/holiday-data/*
  Cache-Control: public, max-age=86400

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400
