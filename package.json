{
  "name": "13calendar",
  "version": "2.0.0",
  "description": "Date conversion, holidays and Moon phases for the Gregorian and International Fixed calendars",
  "productName": "13 Calendar — Date Converter",
  "author": "Jean Rafael Martins <jean7rafael@icloud.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\" \"./scripts/**/*.{js,cjs,mjs}\"",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "conversation:export": "node scripts/exportCodexConversation.mjs",
    "checkpoint": "node scripts/manageWorkCheckpoint.mjs",
    "checkpoint:show": "node scripts/manageWorkCheckpoint.mjs --show",
    "checkpoint:clear": "node scripts/manageWorkCheckpoint.mjs --clear",
    "continuity:audit": "node scripts/manageWorkCheckpoint.mjs --audit",
    "community:profile:audit": "node scripts/auditCommunityProfileTools.mjs",
    "community:feedback:audit": "node scripts/auditReferenceFeedbackVotes.mjs",
    "calendar:conversion:audit": "node scripts/auditCalendarConversions.mjs",
    "ui:audit": "node scripts/auditUiStandards.mjs",
    "education:audit": "node scripts/auditEducationMigration.mjs",
    "holidays:data": "node scripts/generateHolidayData.mjs",
    "holidays:runtime": "node scripts/generateHolidayRuntimeData.mjs",
    "holidays:runtime:audit": "node scripts/auditHolidayRuntimeData.mjs",
    "holidays:audit": "node scripts/auditHolidayCountries.mjs",
    "holidays:weekday:audit": "node scripts/auditHolidayWeekdayRules.mjs",
    "holidays:calendar13:audit": "node scripts/auditCalendar13HolidayRules.mjs",
    "holidays:merge:audit": "node scripts/auditHolidayMerge.mjs",
    "holidays:emoji:audit": "node scripts/auditHolidayEmojis.mjs",
    "holidays:translation:audit": "node scripts/auditHolidayTranslations.mjs",
    "holidays:official:audit": "node scripts/auditOfficialHolidayAppendix.mjs",
    "holidays:official:refresh": "node scripts/refreshOfficialHolidaySources.mjs",
    "holidays:translate": "node scripts/generateHolidayTranslations.mjs --export-manual",
    "holidays:translate:check": "node scripts/generateHolidayTranslations.mjs --check",
    "holidays:translate:export": "node scripts/generateHolidayTranslations.mjs --export-manual",
    "holidays:translate:google-free": "node scripts/translateHolidayFilesWithGoogle.mjs",
    "holidays:translate:ollama": "node scripts/translateHolidayFilesWithOllama.mjs",
    "holidays:translate:import": "node scripts/generateHolidayTranslations.mjs --import-manual",
    "holidays:translate:plan": "node scripts/generateHolidayTranslations.mjs --plan",
    "predev": "npm run holidays:runtime",
    "dev": "quasar dev",
    "prebuild": "npm run holidays:runtime",
    "build": "quasar build",
    "audit:bundle": "node scripts/auditProductionBundle.mjs",
    "audit:production": "npm audit --omit=dev && npm --prefix cloudflare/community-registration-worker audit --omit=dev",
    "verify": "npm run continuity:audit && npm run lint && npm run ui:audit && npm run education:audit && npm run community:profile:audit && npm run community:feedback:audit && npm run calendar:conversion:audit && npm run build && npm run audit:bundle && npm run holidays:runtime:audit && npm run holidays:audit && npm run holidays:weekday:audit && npm run holidays:calendar13:audit && npm run holidays:merge:audit && npm run holidays:emoji:audit && npm run holidays:translation:audit && npm run holidays:official:audit && npm run audit:production",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.4",
    "astronomy-engine": "^2.1.19",
    "date-holidays-parser": "^3.4.7",
    "html2canvas": "^1.4.1",
    "quasar": "^2.16.0",
    "vue": "^3.4.18",
    "vue-i18n": "^11.4.8",
    "vue-router": "^4.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@quasar/app-vite": "2.5.4",
    "@vue/eslint-config-prettier": "^10.1.0",
    "autoprefixer": "^10.4.2",
    "date-holidays": "^3.33.0",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.30.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "typescript-eslint": "^8.66.0",
    "vite": "8.2.1",
    "world-countries": "^5.1.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20 || ^18",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
