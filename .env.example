# Token público do site criado no Cloudflare Web Analytics.
# A aplicação continua funcionando normalmente quando estiver vazio.
VITE_CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# Endereço opcional da página institucional externa.
VITE_REFERENCE_SITE_URL=

# Endereço público do Worker que valida e armazena inscrições.
VITE_COMMUNITY_REGISTRATION_URL=

# Chave pública do Cloudflare Turnstile. Nunca use aqui a chave secreta.
VITE_TURNSTILE_SITE_KEY=
